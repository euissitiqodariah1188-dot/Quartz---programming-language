// test_control.qua — Control flow tests

int main():

    var x = 10

    if x > 5:
        print("greater than 5")
    end!

    if x > 20:
        print("greater than 20")
    else:
        print("not greater than 20")
    end!

    if x == 10:
        print("x is 10")
    end!

    if x != 5:
        print("x is not 5")
    end!

    var a = 1
    var b = 2
    var c = 3

    if a < b:
        print("a less than b")
    end!

    if c >= b:
        print("c >= b")
    end!

    if a <= b:
        print("a <= b")
    end!

    var t = true
    var f = false

    if t:
        print("true branch")
    end!

    if f:
        print("should not print")
    else:
        print("false branch")
    end!

    // Nested if
    var n = 42
    if n > 0:
        if n > 10:
            print("n is big positive")
        else:
            print("n is small positive")
        end!
    end!

    // MOV and ADD
    var counter = 0
    MOV counter 5
    print(counter)
    add counter 3
    print(counter)
