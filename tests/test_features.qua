// test_features.qua — Quartz language features test

int main():

    // Functions
    func greet(name):
        print("Hello")
        print(name)
    end!

    greet("world")

    // MOV instruction
    var counter = 0
    MOV counter 1
    print(counter)

    // ADD instruction
    var num = 5
    add num 10
    print(num)

    // WAIT (sleep 0 ms for test)
    wait 0

    // Split
    var csv = "a,b,c"
    split(csv)

    // Save::
    var source = 42
    save::dest = key = source

    // Point
    var nums = 1
    point nums = 1

    // IF/ELSE
    var val = 10
    if val > 5:
        print("greater than 5")
    else:
        print("not greater")
    end!

    // Reverse keyword
    var items = 1
    reverse

    // Nested function
    func add_nums(a, b):
        var result = a + b
        return result
    end!

    var total = add_nums(3, 7)
    print(total)
