// test_functions.qua — Function tests

int main():

    func qz_add(a, b):
        var result = a + b
        return result
    end!

    func qz_multiply(a, b):
        var result = a * b
        return result
    end!

    func greet(name):
        print("Hello")
        print(name)
    end!

    func square(n):
        return n * n
    end!

    func is_even(n):
        var r = n - (n / 2) * 2
        if r == 0:
            return 1
        else:
            return 0
        end!
    end!

    func max3(a, b, c):
        var m = max(a, b)
        return max(m, c)
    end!

    var s = qz_add(3, 4)
    print(s)

    var p = qz_multiply(6, 7)
    print(p)

    greet("quartz")

    var sq = square(9)
    print(sq)

    var ev = is_even(4)
    print(ev)

    var od = is_even(7)
    print(od)

    var m3 = max3(10, 30, 20)
    print(m3)
